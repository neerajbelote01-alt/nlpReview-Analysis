# ReviewIQ AI Environment Configuration Example

PROJECT_NAME="ReviewIQ AI"
API_V1_STR="/api"

# Secret Key for JWT Authentication (generate a random 32+ char string in production)
SECRET_KEY="your-super-secret-jwt-key-change-in-production-reviewiq-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite by default, or PostgreSQL)
# Example SQLite: sqlite:///./reviewiq.db
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/reviewiq_db
DATABASE_URL="sqlite:///./reviewiq.db"

# Allowed CORS Origins (JSON list string)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Frontend API Base URL
VITE_API_BASE_URL="/api"
